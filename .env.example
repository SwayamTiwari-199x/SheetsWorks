# Copy to .env and fill in one key. Never commit .env.

# gemini | groq | mistral | anthropic | openrouter
LLM_PROVIDER=anthropic

# Optional: overrides the per-provider default model.
# LLM_MODEL=claude-sonnet-4-5
#
# REQUIRED for openrouter, which has no default: free model ids there rotate, so
# nothing is hardcoded on your behalf. Current list: https://openrouter.ai/models
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Key for the selected provider only; the others are ignored.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

DATABASE_URL=sqlite:///./resume.db
LOG_DIR=logs
